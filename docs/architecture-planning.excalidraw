      "roundness": null,
      "seed": 1141619628,
      "version": 1,
      "versionNonce": 1374874903,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794000000000,
      "link": null,
      "locked": false,
      "text": "Planning and Overview share appointments, medications and the events the patient confirmed through ObservePlanning.\nEvents are optional: if they can't be read, appointments and medications still show. A caregiver gets medications and events only if the patient also shares Prescriptions and Events.\nAppointment rows and the next-appointment card open AppointmentDetailScreen, event rows open EventDetailScreen; Back returns to the origin.\nPlanned: a medication row opens its prescription's detail (US-35).",
      "originalText": "Planning and Overview share appointments, medications and the events the patient confirmed through ObservePlanning.\nEvents are optional: if they can't be read, appointments and medications still show. A caregiver gets medications and events only if the patient also shares Prescriptions and Events.\nAppointment rows and the next-appointment card open AppointmentDetailScreen, event rows open EventDetailScreen; Back returns to the origin.\nPlanned: a medication row opens its prescription's detail (US-35).",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
