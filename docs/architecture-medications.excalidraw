      "seed": 254861318,
      "version": 1,
      "versionNonce": 267186447,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794000000000,
      "link": null,
      "locked": false,
      "text": "Nothing drafted from a scan is saved until the user confirms it in the prescription form. ManageMedicationSchedule is the only way\nmedications are written, so reminders can follow them later (see Reminders). A caregiver adding a prescription (US-43) leaves it\nwaiting for the patient, who confirms or rejects it: MedicationRepository stores both (#336); intakes (US-28) are stored in Firestore too.\nUS-35: MedicationDetailScreen reads one prescription through ObserveCareSection, then opens PrescriptionDetailScreen.",
      "originalText": "Nothing drafted from a scan is saved until the user confirms it in the prescription form. ManageMedicationSchedule is the only way\nmedications are written, so reminders can follow them later (see Reminders). A caregiver adding a prescription (US-43) leaves it\nwaiting for the patient, who confirms or rejects it: MedicationRepository stores both (#336); intakes (US-28) are stored in Firestore too.\nUS-35: MedicationDetailScreen reads one prescription through ObserveCareSection, then opens PrescriptionDetailScreen.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
