      "seed": 1146078970,
      "version": 1,
      "versionNonce": 144541032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794000000000,
      "link": null,
      "locked": false,
      "text": "The reminders epic: a patient is reminded before appointments (US-16), before events\n(US-31) and at medication times (US-32), and chooses which in the notification\npreferences (US-37). A caregiver can be reminded of the patient's (US-21, US-33, US-34).\nManageMedicationSchedule is the only way medications are written, so it will keep\ntheir reminders in sync.",
      "originalText": "The reminders epic: a patient is reminded before appointments (US-16), before events\n(US-31) and at medication times (US-32), and chooses which in the notification\npreferences (US-37). A caregiver can be reminded of the patient's (US-21, US-33, US-34).\nManageMedicationSchedule is the only way medications are written, so it will keep\ntheir reminders in sync.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
