rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Field `key` is absent, null, or a string of at most `max` characters
    function optionalString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    // ---------- Users ----------
    // Each user has one profile document: /users/{uid}. Only they can read or write it.
    // Keep the limits in sync with UserProfile (MAX_NAME_LENGTH, MAX_CANCER_TYPE_LENGTH).
    function isValidProfile(data) {
      return data.keys().hasOnly(['role', 'firstName', 'familyName', 'cancerType', 'createdAt'])
          && data.keys().hasAll(['role', 'firstName', 'createdAt'])
          && data.role in ['PATIENT', 'CAREGIVER']
          && data.firstName is string
          && data.firstName.trim().size() > 0
          && data.firstName.size() <= 50
          && optionalString(data, 'familyName', 50)
          && optionalString(data, 'cancerType', 100)
          && data.createdAt is timestamp;
    }

    // Keep the limit in sync with Prescription (MAX_PRESCRIBED_BY_LENGTH).
    function isValidPrescription(data) {
      return data.keys().hasOnly(['prescribedBy', 'prescribedOn', 'createdAt'])
          && data.keys().hasAll(['prescribedOn', 'createdAt'])
          && optionalString(data, 'prescribedBy', 100)
          && data.prescribedOn is timestamp
          && data.createdAt is timestamp;
    }

    // Keep the limits in sync with Medication (MAX_TEXT_LENGTH, MAX_DURATION_DAYS) and
    // Prescription (MAX_MEDICATIONS, for the position).
    function isValidMedication(data) {
      return data.keys().hasOnly(['prescriptionId', 'name', 'dosage', 'frequency', 'startDate',
                                  'durationDays', 'position'])
          && data.keys().hasAll(['prescriptionId', 'name', 'startDate', 'position'])
          && data.prescriptionId is string
          && data.prescriptionId.trim().size() > 0
          && data.name is string
          && data.name.trim().size() > 0
          && data.name.size() <= 100
          && optionalString(data, 'dosage', 100)
          && optionalString(data, 'frequency', 100)
          && data.startDate is timestamp
          // No duration = no end date
          && (data.get('durationDays', null) == null
              || (data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 3650))
          // Rank of the medication in its prescription
          && data.position is int
          && data.position >= 0
          && data.position < 20;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    // The role is chosen during onboarding and can't change afterwards (care-circle
                    // access will depend on it)
                    && request.resource.data.role == resource.data.role;

      // ---------- Prescriptions and medications ----------
      // /users/{uid}/prescriptions/{prescriptionId}: what the medications of a prescription share.
      match /prescriptions/{prescriptionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && isValidPrescription(request.resource.data)
                      && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
                      && isValidPrescription(request.resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt;
      }

      // /users/{uid}/medications/{medicationId}: one per medication, linked to its prescription.
      match /medications/{medicationId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidMedication(request.resource.data);
        allow update: if isOwner(uid)
                      && isValidMedication(request.resource.data)
                      // A medication stays in the prescription it was saved with
                      && request.resource.data.prescriptionId == resource.data.prescriptionId;
      }

      // Everything personal (entries, records, reminders...) goes under the user, in a collection
      // with its own `match` above. There is no catch-all rule: a collection without one is denied.
    }

    // ---------- Everything else ----------
    // No rule matches = denied. Add one explicit `match` per new collection.
  }
}
