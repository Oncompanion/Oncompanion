rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Field `key` is absent, null, or a string of at most `max` characters
    function optionalString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    // ---------- Users ----------
    // Each user has one profile document: /users/{uid}. Only they can read or write it.
    // Keep the limits in sync with UserProfile (MAX_NAME_LENGTH, MAX_CANCER_TYPE_LENGTH).
    function isValidProfile(data) {
      return data.keys().hasOnly(['role', 'firstName', 'familyName', 'cancerType', 'createdAt'])
          && data.keys().hasAll(['role', 'firstName', 'createdAt'])
          && data.role in ['PATIENT', 'CAREGIVER']
          && data.firstName is string
          && data.firstName.trim().size() > 0
          && data.firstName.size() <= 50
          && optionalString(data, 'familyName', 50)
          && optionalString(data, 'cancerType', 100)
          && data.createdAt is timestamp;
    }

    // Keep the limits in sync with Prescription (MAX_PRESCRIBED_BY_LENGTH, MAX_MEDICATIONS).
    // The fields of each medication are not checked here: rules have no loops, and checking 20
    // entries one by one exceeds the limit of 1000 expressions per request (about 4 fit). The app
    // checks them before saving (Medication.isValid) and skips the ones it can't read.
    function isValidPrescription(data) {
      return data.keys().hasOnly(['prescribedBy', 'prescribedOn', 'createdAt', 'medications'])
          && data.keys().hasAll(['prescribedOn', 'createdAt', 'medications'])
          && optionalString(data, 'prescribedBy', 100)
          && data.prescribedOn is timestamp
          && data.createdAt is timestamp
          && data.medications is list
          && data.medications.size() >= 1
          && data.medications.size() <= 20;
    }

    // Keep the limits in sync with SymptomEntry (MIN_INTENSITY, MAX_INTENSITY,
    // MAX_OTHER_LABEL_LENGTH, MAX_NOTES_LENGTH, MAX_CLOCK_DRIFT).
    function isValidSymptom(data) {
      return data.keys().hasOnly(['type', 'otherLabel', 'intensity', 'occurredAt', 'notes', 'createdAt'])
          && data.keys().hasAll(['type', 'intensity', 'occurredAt', 'createdAt'])
          && data.type in ['FATIGUE', 'NAUSEA', 'PAIN', 'APPETITE_LOSS', 'SLEEP_PROBLEMS',
                           'BREATHLESSNESS', 'OTHER']
          // "Other" needs a label; the listed types have none
          && (data.type == 'OTHER'
              ? data.get('otherLabel', null) is string
                  && data.otherLabel.trim().size() > 0
                  && data.otherLabel.size() <= 50
              : data.get('otherLabel', null) == null)
          && data.intensity is int
          && data.intensity >= 1
          && data.intensity <= 10
          && data.occurredAt is timestamp
          // Not in the future (it would stay at the top of the journal), with 5 minutes of margin
          // for a phone clock ahead of the server's. Offline writes reach the server later, so
          // request.time is then even later.
          && data.occurredAt <= request.time + duration.value(5, 'm')
          && optionalString(data, 'notes', 1000)
          && data.createdAt is timestamp;
    }

    // ---------- Appointments ----------
    // Schema: title (required nonblank string, at most 100), scheduledAt (timestamp),
    // type (recorded category), location (optional string, 200), notes (optional string, 1000),
    // createdAt (server timestamp). Identity and ownership come from the document path.
    // Keep the limits in sync with Appointment.MAX_TITLE_LENGTH/MAX_LOCATION_LENGTH/MAX_NOTES_LENGTH.
    function isValidAppointment(data) {
      return data.keys().hasOnly(['title', 'scheduledAt', 'type', 'location', 'notes', 'createdAt'])
          && data.keys().hasAll(['title', 'scheduledAt', 'type', 'createdAt'])
          && data.title is string
          && data.title.trim().size() > 0
          && data.title.size() <= 100
          && data.scheduledAt is timestamp
          && data.type in ['TREATMENT', 'CONSULTATION', 'OTHER']
          && optionalString(data, 'location', 200)
          && optionalString(data, 'notes', 1000)
          && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    // The role is chosen during onboarding and can't change afterwards (care-circle
                    // access will depend on it)
                    && request.resource.data.role == resource.data.role;

      // ---------- Prescriptions ----------
      // /users/{uid}/prescriptions/{prescriptionId}: a prescription and the list of its
      // medications, in one document. There is no medications collection.
      match /prescriptions/{prescriptionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
                      && isValidPrescription(request.resource.data)
                      && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
                      && isValidPrescription(request.resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ---------- Symptoms ----------
      // /users/{uid}/symptoms/{symptomId}: the symptom journal. Entries can't be changed yet.
      match /symptoms/{symptomId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && isValidSymptom(request.resource.data)
                      && request.resource.data.createdAt == request.time;
      }

      // ---------- Appointments ----------
      // /users/{uid}/appointments/{appointmentId}: only the owner can read and create.
      // Editing, deletion and caregiver access stay denied until their features are implemented.
      match /appointments/{appointmentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && isValidAppointment(request.resource.data)
                      && request.resource.data.createdAt == request.time;
      }

      // ---------- Care circle ----------
      // /users/{uid}/circle/{memberUid}: the people the user shares their care with, keyed by the
      // member's uid. Only the owner can read it. Writes stay denied until adding a member comes
      // with their validation.
      match /circle/{memberUid} {
        allow read: if isOwner(uid);
      }

      // Everything personal (entries, records, reminders...) goes under the user, in a collection
      // with its own `match` above. There is no catch-all rule: a collection without one is denied.
    }

    // ---------- Everything else ----------
    // No rule matches = denied. Add one explicit `match` per new collection.
  }
}
