// Co-authored-by: Codex <noreply@openai.com>
// Co-authored-by: ChatGPT <noreply@openai.com>
// Co-authored-by: Claude Code <noreply@anthropic.com>

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Field `key` is absent, null, or a string of at most `max` characters
    function optionalString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    // ---------- Users ----------
    // Each user has one profile document: /users/{uid}. Only they can read or write it.
    // Keep the limits in sync with UserProfile (MAX_NAME_LENGTH, MAX_CANCER_TYPE_LENGTH, MAX_HOSPITAL_LENGTH).
    function isValidProfile(data) {
      return data.keys().hasOnly(['role', 'firstName', 'familyName', 'cancerType', 'hospital', 'createdAt'])
          && data.keys().hasAll(['role', 'firstName', 'createdAt'])
          && data.role in ['PATIENT', 'CAREGIVER']
          && data.firstName is string
          && data.firstName.trim().size() > 0
          && data.firstName.size() <= 50
          && optionalString(data, 'familyName', 50)
          && optionalString(data, 'cancerType', 100)
          && optionalString(data, 'hospital', 100)
          && data.createdAt is timestamp;
    }
    // Who added an entry: nothing when the patient did, or the signed-in caregiver's uid and first
    // name when a caregiver did (US-22, US-41), so nobody can add one in someone else's name.
    // Keep in sync with SymptomEntry and Appointment (MAX_ADDED_BY_NAME_LENGTH).
    function isValidAttribution(ownerUid, data) {
      return isOwner(ownerUid)
          ? !data.keys().hasAny(['addedBy', 'addedByName'])
          : data.get('addedBy', null) == request.auth.uid
              && data.get('addedByName', null) is string
              && data.addedByName.trim().size() > 0
              && data.addedByName.size() <= 50;
    }
    // The attribution of an entry never changes, also when the patient corrects it
    function keepsAttribution(data, previous) {
      return data.get('addedBy', null) == previous.get('addedBy', null)
          && data.get('addedByName', null) == previous.get('addedByName', null);
    }

    // Keep the limits in sync with Prescription (MAX_PRESCRIBED_BY_LENGTH, MAX_MEDICATIONS).
    // The fields of each medication are not checked here: rules have no loops, and checking 20
    // entries one by one exceeds the limit of 1000 expressions per request (about 4 fit). The app
    // checks them before saving (Medication.isValid) and skips the ones it can't read.
    // A caregiver's prescription (US-43) also says who added it and whether the patient confirmed
    // it; the patient's own is always confirmed. Keep in sync with PrescriptionConfirmation.
    function isValidPrescription(data) {
      return data.keys().hasOnly(['prescribedBy', 'prescribedOn', 'createdAt', 'medications',
                                  'addedBy', 'addedByName', 'confirmation'])
          && data.keys().hasAll(['prescribedOn', 'createdAt', 'medications'])
          && confirmationOf(data) in ['CONFIRMED', 'PENDING', 'REJECTED']
          && (data.get('addedBy', null) != null || confirmationOf(data) == 'CONFIRMED')
          && optionalString(data, 'prescribedBy', 100)
          && data.prescribedOn is timestamp
          && data.createdAt is timestamp
          && data.medications is list
          && data.medications.size() >= 1
          && data.medications.size() <= 20;
    }

    // Saved before US-43 without the field: the patient's own, so confirmed
    function confirmationOf(data) {
      return data.get('confirmation', 'CONFIRMED');
    }
    // Only the patient decides: a prescription waiting for them becomes confirmed, and can't be
    // edited without being confirmed; a confirmed one stays confirmed. A rejected one moves to
    // rejectedPrescriptions instead (wasWaitingFor).
    function decidesConfirmation(data, previous) {
      return confirmationOf(previous) == 'PENDING'
          ? confirmationOf(data) == 'CONFIRMED'
          : confirmationOf(data) == confirmationOf(previous);
    }

    // The signed-in user is the caregiver who added this prescription
    function addedIt(data) {
      return signedIn() && data.get('addedBy', null) == request.auth.uid;
    }

    // [data] is the prescription [id] of [uid] that was waiting for the patient, rejected and moved
    // out of their prescriptions in the same write, with who added it
    function wasWaitingFor(uid, id, data) {
      let path = /databases/$(database)/documents/users/$(uid)/prescriptions/$(id);
      return exists(path)
          && !existsAfter(path)
          && confirmationOf(get(path).data) == 'PENDING'
          && data.addedBy == get(path).data.addedBy
          && data.addedByName == get(path).data.addedByName;
    }

    // Keep the limits in sync with SymptomEntry (MIN_INTENSITY, MAX_INTENSITY, MAX_NOTES_LENGTH,
    // MAX_CLOCK_DRIFT).
    function isValidSymptom(data) {
      return data.keys().hasOnly(['types', 'intensity', 'occurredAt', 'notes', 'createdAt',
                                  'addedBy', 'addedByName'])
          && data.keys().hasAll(['types', 'occurredAt', 'createdAt'])
          // One or more symptoms, each at most once
          && data.types is list
          && data.types.size() >= 1
          && data.types.toSet().size() == data.types.size()
          && data.types.hasOnly(['FATIGUE', 'NAUSEA', 'PAIN', 'FEVER', 'HEADACHE', 'APPETITE_LOSS',
                                 'SLEEP_PROBLEMS', 'BREATHLESSNESS', 'OTHER'])
          // The intensity is optional
          && (data.get('intensity', null) == null
              || (data.intensity is int && data.intensity >= 1 && data.intensity <= 10))
          && data.occurredAt is timestamp
          // Not in the future (it would stay at the top of the journal), with 5 minutes of margin
          // for a phone clock ahead of the server's. Offline writes reach the server later, so
          // request.time is then even later.
          && data.occurredAt <= request.time + duration.value(5, 'm')
          && optionalString(data, 'notes', 1000)
          // With "Other", the notes say which symptom it was
          && (!('OTHER' in data.types)
              || (data.get('notes', null) is string && data.notes.trim().size() > 0))
          && data.createdAt is timestamp;
    }

    // ---------- Appointments ----------
    // Schema: title (required nonblank string, at most 100), scheduledAt (timestamp),
    // type (recorded category), location (optional string, 200), notes (optional string, 1000),
    // createdAt (server timestamp), and addedBy/addedByName for a caregiver's appointment (see
    // isValidAttribution). Identity and ownership come from the document path.
    function hasAppointmentTitleText(title) {
      // Match Kotlin Char.isWhitespace, including Unicode spaces that Rules trim() preserves.
      return title.matches('(?s).*[^\\x{0009}-\\x{000D}\\x{001C}-\\x{0020}\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}].*');
    }

    // Keep the limits in sync with Appointment.MAX_TITLE_LENGTH/MAX_LOCATION_LENGTH/MAX_NOTES_LENGTH.
    function isValidAppointment(data) {
      return data.keys().hasOnly(['title', 'scheduledAt', 'type', 'location', 'notes', 'createdAt',
                                  'addedBy', 'addedByName'])
          && data.keys().hasAll(['title', 'scheduledAt', 'type', 'createdAt'])
          && data.title is string
          && hasAppointmentTitleText(data.title)
          && data.title.size() <= 100
          && data.scheduledAt is timestamp
          && data.type in ['TREATMENT', 'CONSULTATION', 'OTHER']
          && optionalString(data, 'location', 200)
          && optionalString(data, 'notes', 1000)
          && data.createdAt is timestamp;
    }

    // ---------- Care circle helpers ----------
    // What the patient decides about someone in their circle, on an invite and on a member.
    // Keep in sync with CareCircleMemberDetails (MAX_NAME_LENGTH, canAdd), Relationship and
    // CarePermission. canAdd is optional (missing on members saved before it existed) and only
    // holds sections that are also in permissions.
    function isValidCareCircleMemberDetails(data) {
      return data.firstName is string
          && data.firstName.trim().size() > 0
          && data.firstName.size() <= 50
          && optionalString(data, 'familyName', 50)
          && data.relationship in ['WIFE', 'HUSBAND', 'PARTNER', 'MOTHER', 'FATHER', 'DAUGHTER',
                                   'SON', 'SISTER', 'BROTHER', 'FRIEND', 'HOME_NURSE', 'OTHER']
          && data.permissions is list
          && data.permissions.size() <= 4
          && data.permissions.hasOnly(['PLANNING', 'EVENTS', 'SYMPTOMS', 'PRESCRIPTIONS'])
          && data.get('canAdd', []) is list
          && data.permissions.hasAll(data.get('canAdd', []));
    }
    // What the patient can change on a member; an invite also has its email.
    function detailKeys() {
      return ['firstName', 'familyName', 'relationship', 'permissions', 'canAdd'];
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function invitePath(inviteCode) {
      return /databases/$(database)/documents/invites/$(inviteCode);
    }
    // How long an invite code can be used. Keep in sync with CareCircleInvite.VALIDITY.
    function isUnexpired(invite) {
      return request.time < invite.createdAt + duration.value(7, 'd');
    }
    // The unexpired invite for ownerUid's circle exists before this request, and the same request
    // deletes it. `get` reads the database before the request and `existsAfter` as if it succeeded.
    // A used invite no longer exists, so an invite code works once and can't be used again after
    // the member is removed.
    function redeemsInvite(inviteCode, ownerUid) {
      let invite = get(invitePath(inviteCode)).data;
      return invite.ownerUid == ownerUid
          && isUnexpired(invite)
          && !existsAfter(invitePath(inviteCode));
    }
    // The member doc repeats exactly what the patient decided on the invite.
    function copiesInvite(member, invite) {
      return member.firstName == invite.firstName
          && member.get('familyName', null) == invite.get('familyName', null)
          && member.relationship == invite.relationship
          && member.permissions == invite.permissions
          && member.get('canAdd', []) == invite.get('canAdd', []);
    }
    // The signed-in user's member doc in ownerUid's circle: the one a caregiver already reads.
    function memberDoc(ownerUid) {
      return /databases/$(database)/documents/users/$(ownerUid)/circle/$(request.auth.uid);
    }
    // The signed-in user is in ownerUid's circle and the patient shares `section` with them.
    // It doesn't depend on `resource`, so a query on a whole collection is allowed or denied at once.
    // signedIn() comes first: memberDoc needs request.auth.
    function sharesWith(ownerUid, section) {
      return signedIn() && memberShares(get(memberDoc(ownerUid)), section);
    }
    // `member` exists and its permissions are a list holding `section` (`in` would also match the
    // keys of a map).
    function memberShares(member, section) {
      return member != null
          && member.data.get('permissions', null) is list
          && section in member.data.permissions;
    }
    // The owner, or a member the owner shares `section` with (a CarePermission). Read only:
    // writes stay owner-only, except adding where canAdd allows it.
    function canRead(ownerUid, section) {
      return isOwner(ownerUid) || sharesWith(ownerUid, section);
    }
    // The owner, or a member who sees `section` and whom the owner lets add to it (canAdd). Only
    // for creating: a member never edits or deletes.
    function canAddTo(ownerUid, section) {
      return isOwner(ownerUid) || (signedIn() && memberAdds(get(memberDoc(ownerUid)), section));
    }
    function memberAdds(member, section) {
      return memberShares(member, section)
          && member.data.get('canAdd', null) is list
          && section in member.data.canAdd;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    // The role is chosen during onboarding and can't change afterwards (care-circle
                    // access will depend on it)
                    && request.resource.data.role == resource.data.role;

      // ---------- Prescriptions ----------
      // /users/{uid}/prescriptions/{prescriptionId}: a prescription and the list of its
      // medications, in one document. There is no medications collection.
      match /prescriptions/{prescriptionId} {
        allow read: if canRead(uid, 'PRESCRIPTIONS');
        allow delete: if isOwner(uid);
        // A caregiver the patient lets add prescriptions creates one waiting for the patient,
        // signed with their identity (US-43)
        allow create: if canAddTo(uid, 'PRESCRIPTIONS')
                      && isValidPrescription(request.resource.data)
                      && isValidAttribution(uid, request.resource.data)
                      && (isOwner(uid) || confirmationOf(request.resource.data) == 'PENDING')
                      && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
                      && isValidPrescription(request.resource.data)
                      && keepsAttribution(request.resource.data, resource.data)
                      && decidesConfirmation(request.resource.data, resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ---------- Rejected prescriptions ----------
      // /users/{uid}/rejectedPrescriptions/{prescriptionId}: a prescription a caregiver added that
      // the patient rejected (US-43), moved out of their prescriptions so no other member sees it.
      // The patient and the caregiver who added it read it; only that caregiver deletes it, once
      // they saw it, even without the right to edit the patient's prescriptions.
      match /rejectedPrescriptions/{prescriptionId} {
        allow read: if isOwner(uid) || addedIt(resource.data);
        allow delete: if addedIt(resource.data);
        allow create: if isOwner(uid)
                      && isValidPrescription(request.resource.data)
                      && confirmationOf(request.resource.data) == 'REJECTED'
                      && wasWaitingFor(uid, prescriptionId, request.resource.data)
                      && request.resource.data.createdAt == request.time;
      }

      // ---------- Symptoms ----------
      // /users/{uid}/symptoms/{symptomId}: the symptom journal. Editing an entry follows the same
      // validation as logging it, and keeps when it was first logged.
      match /symptoms/{symptomId} {
        allow read: if canRead(uid, 'SYMPTOMS');
        allow delete: if isOwner(uid);
        allow create: if canAddTo(uid, 'SYMPTOMS')
                      && isValidSymptom(request.resource.data)
                      && isValidAttribution(uid, request.resource.data)
                      && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
                      && isValidSymptom(request.resource.data)
                      && keepsAttribution(request.resource.data, resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ---------- Appointments ----------
      // /users/{uid}/appointments/{appointmentId}: read by the owner and by members the owner
      // shares Planning with. Created by the owner, or by a member the owner lets add to Planning
      // (US-41), signed with their uid; edited and deleted by the owner only, who keeps who added
      // it.
      match /appointments/{appointmentId} {
        allow read: if canRead(uid, 'PLANNING');
        allow delete: if isOwner(uid);
        allow create: if canAddTo(uid, 'PLANNING')
                      && isValidAppointment(request.resource.data)
                      && isValidAttribution(uid, request.resource.data)
                      && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
                      && isValidAppointment(request.resource.data)
                      && keepsAttribution(request.resource.data, resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ---------- Event registrations ----------
      // /users/{uid}/eventRegistrations/{eventId}: the user's own statement that they registered
      // with the organizer of /events/{eventId}. It is keyed by the event, so confirming twice
      // writes the same document instead of a duplicate. Members the owner shares Events with
      // can read it; only the owner removes it. A member the owner lets confirm events (US-42)
      // can save one that doesn't exist yet, signed with their identity, never replace one.
      // Saving needs an existing event that hasn't started yet, by the server's clock: a
      // confirmation made offline that only syncs once the event has started is rejected.
      match /eventRegistrations/{eventId} {
        function isUpcomingEvent() {
          let event = /databases/$(database)/documents/events/$(eventId);
          return exists(event) && get(event).data.startAt > request.time;
        }
        function isValidRegistration(data) {
          return data.keys().hasOnly(['confirmedAt', 'addedBy', 'addedByName'])
              && data.confirmedAt == request.time
              && isUpcomingEvent();
        }
        allow read: if canRead(uid, 'EVENTS');
        allow delete: if isOwner(uid);
        allow create: if canAddTo(uid, 'EVENTS')
                      && isValidRegistration(request.resource.data)
                      && isValidAttribution(uid, request.resource.data);
        allow update: if isOwner(uid)
                      && isValidRegistration(request.resource.data)
                      && keepsAttribution(request.resource.data, resource.data);
      }

      // ---------- Care circle ----------
      // /users/{uid}/circle/{memberUid}: the people the user shares their care with, keyed by the
      // member's uid. The owner and that member can read it. Only created by the member redeeming
      // an invite, as a copy of it with their account email; then only the owner changes what
      // they decided about the member (not the email, invite code or join time) or removes them.
      match /circle/{memberUid} {
        allow read: if isOwner(uid) || isOwner(memberUid);
        allow create: if isOwner(memberUid)
                      && memberUid != uid
                      && request.resource.data.keys().hasOnly(detailKeys().concat(
                             ['email', 'inviteCode', 'addedAt']))
                      && request.resource.data.get('email', null)
                             == request.auth.token.get('email', null)
                      && request.resource.data.addedAt == request.time
                      && redeemsInvite(request.resource.data.inviteCode, uid)
                      && copiesInvite(request.resource.data,
                             get(invitePath(request.resource.data.inviteCode)).data);
        allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(detailKeys())
                      && isValidCareCircleMemberDetails(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ---------- Care circles joined ----------
      // /users/{uid}/patients/{patientUid}: the circles this caregiver joined, created with the
      // member doc when redeeming an invite. The patient deletes it when removing the caregiver:
      // the only write a patient makes into another user's data, so no link to a circle the
      // caregiver can no longer read is left behind.
      match /patients/{patientUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && patientUid != uid
                      && request.resource.data.keys().hasOnly(
                             ['patientFirstName', 'inviteCode', 'joinedAt'])
                      && request.resource.data.joinedAt == request.time
                      && redeemsInvite(request.resource.data.inviteCode, patientUid)
                      && request.resource.data.patientFirstName
                             == get(invitePath(request.resource.data.inviteCode)).data.ownerFirstName;
        allow delete: if isOwner(patientUid);
      }

      // Everything personal (entries, records, reminders...) goes under the user, in a collection
      // with its own `match` above. There is no catch-all rule: a collection without one is denied.
    }

    // ---------- Ligue events ----------
    // /events/{eventId}: the Ligue's support events, the same for every user. They are added from
    // the Firebase console for now, so the app can only read them.
    match /events/{eventId} {
      allow read: if signedIn();
    }

    // ---------- Care circle invites ----------
    // /invites/{inviteCode}: a pending care circle member, deleted once used. The invite code is
    // the secret: anyone signed in can get a valid invite by its code, only the owner can list
    // theirs. Unknown, used (deleted) and expired invite codes are all refused alike, so nobody but
    // the owner learns that an invite code existed. Keep the invite code format in sync with
    // CareCircleInvite and the email limit with MAX_EMAIL_LENGTH.
    match /invites/{inviteCode} {
      allow get: if signedIn()
                 && resource != null
                 && (isOwner(resource.data.ownerUid) || isUnexpired(resource.data));
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
                    && inviteCode.matches('^[A-HJKMNP-Z2-9]{10}$')
                    && request.resource.data.keys().hasOnly(detailKeys().concat(
                           ['email', 'ownerUid', 'ownerFirstName', 'createdAt', 'redeemerUid']))
                    && request.resource.data.keys().hasAll(
                           ['ownerUid', 'ownerFirstName', 'firstName', 'relationship',
                            'permissions', 'createdAt', 'redeemerUid'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerFirstName is string
                    && request.resource.data.ownerFirstName.size() <= 50
                    && optionalString(request.resource.data, 'email', 254)
                    && request.resource.data.redeemerUid == null
                    && request.resource.data.createdAt == request.time
                    && isValidCareCircleMemberDetails(request.resource.data);
      // The patient edits an invite that hasn't been used
      allow update: if isOwner(resource.data.ownerUid)
                    && resource.data.redeemerUid == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(detailKeys().concat(['email']))
                    && optionalString(request.resource.data, 'email', 254)
                    && isValidCareCircleMemberDetails(request.resource.data);
      allow delete: if
          // The patient cancels it
          isOwner(resource.data.ownerUid)
          // A caregiver uses it up: before it expires, in the same request that creates their
          // member doc (with this invite code) and their own link to the patient
          || (signedIn()
              && resource.data.ownerUid != request.auth.uid
              && isUnexpired(resource.data)
              && get(userPath(request.auth.uid)).data.role == 'CAREGIVER'
              && getAfter(/databases/$(database)/documents/users/$(resource.data.ownerUid)/circle/$(request.auth.uid)).data.inviteCode == inviteCode
              && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/patients/$(resource.data.ownerUid)));
    }

    // ---------- Everything else ----------
    // No rule matches = denied. Add one explicit `match` per new collection.
  }
}
