<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+): nothing is backed up to the cloud or copied to a new device.
   The app stores health data (Firestore offline cache); it is synced with Firestore and comes back
   when the user signs in on another device, so no local copy should leave the phone.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
